# Upstream-API (Default: OpenRouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Fallback-Key, falls OpenWebUI keinen Authorization-Header mitschickt.
# Normalerweise leer lassen – OpenWebUI schickt seinen konfigurierten Key mit.
OPENROUTER_API_KEY=

# Optional: Dashboard schützen. Aufruf dann: http://<host>:8800/?token=<wert>
DASHBOARD_TOKEN=

# NER-Engine: "gliner" (GLiNER2-PII-Kontextmodell, empfohlen) oder "spacy"
NER_ENGINE=gliner

# GLiNER-Einstellungen (nur bei NER_ENGINE=gliner relevant)
GLINER_MODEL=fastino/gliner2-privacy-filter-PII-multi
GLINER_THRESHOLD=0.5
# Welche PII-Typen GLiNER suchen soll (42 verfügbar, s. Modellkarte)
#GLINER_LABELS=person,email,phone_number,address,city,country,iban,payment_card,bank_account,ip_address,username,passport_number,national_id_number,date_of_birth,password,api_key
# Schwellen pro Label, z.B. weniger Namens-False-Positives:
#GLINER_LABEL_THRESHOLDS=person:0.55

# PII-Erkennung
DEFAULT_LANGUAGE=de
SCORE_THRESHOLD=0.4
ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IBAN_CODE,CREDIT_CARD,IP_ADDRESS,LOCATION,AHV_NUMBER

# NER-Treffer (PERSON/LOCATION/ORG) nur akzeptieren, wenn sie ein
# Eigennamen-Token (PROPN) enthalten. Filtert False Positives wie Verben.
NER_REQUIRE_PROPN=true

# Wörter, die nie anonymisiert werden sollen (kommagetrennt, case-insensitive).
# Notausgang für hartnäckige False Positives, z.B.: NER_IGNORE_WORDS=Schreib,Erstelle
NER_IGNORE_WORDS=
